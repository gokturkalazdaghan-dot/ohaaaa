# =============================================================================
# OHAAAA — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve doldurun. `.env` git'e ASLA girmez.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Proje ayarları > API bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role anahtarı RLS'i BYPASS EDER.
# Yalnızca sunucuda kullanılır; NEXT_PUBLIC_ ön eki ASLA verilmemelidir.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Taşeron API (packages/backend) -----------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Virgülle ayrılmış izinli origin listesi. Üretimde '*' KULLANMAYIN.
CORS_ORIGINS=http://localhost:3000

# Anahtar başına dakikalık istek tavanının mutlak üst sınırı.
RATE_LIMIT_CEILING=6000

# --- Web (apps/web) ----------------------------------------------------------
# Taşeron API'si artık SİTENİN KENDİSİNDE sunulur (/api/v1/*). Bu değişkeni
# ayarlamaya gerek yoktur; boş bırakılırsa dokümantasyon sitenin kendi
# adresini gösterir. Yalnızca API ayrı bir alan adına taşınırsa doldurun.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Yayın durumu ------------------------------------------------------------
# prelaunch : site erişilebilir ama arama motorlarına KAPALI
# live      : tam yayın
#
# VARSAYILAN 'live'DIR. Yani bu değişken ayarlanmazsa site indekslenir.
#
# Buradaki metin uzun süre bunun TERSİNİ söylüyordu ("ayarlanmazsa prelaunch
# kabul edilir — güvenli tarafta hata yapar"). Kod hiçbir zaman öyle
# davranmadı: `lib/env.ts` yalnızca değer tam olarak 'prelaunch' ise
# prelaunch sayar. Belge fail-closed, kod fail-open anlatıyordu; ikisi de
# kendi içinde tutarlıydı ve fark ancak kod okunarak görülüyordu.
#
# 'live' bırakmadan ÖNCE: işletme kaydı, ETBİS numarası ve aşağıdaki
# NEXT_PUBLIC_BUSINESS_* alanları tamamlanmış olmalı. Tamamlanmamışsa
# sunucu günlüğüne yapısal bir uyarı düşer (bkz. isLaunchStateConsistent)
# ve yasal sayfalarda ziyaretçiye görünür bir uyarı gösterilir.
#
# Künye tamamlanana kadar bu değeri açıkça 'prelaunch' yapmak önerilir.
NEXT_PUBLIC_LAUNCH_STATE=prelaunch

# --- SEO ve ölçümleme --------------------------------------------------------
# Google Analytics 4 ölçüm kimliği. BOŞSA betik hiç yüklenmez.
# Yüklense bile kullanıcı çerez onayı vermeden çalışmaz (KVKK).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console doğrulama kodu (meta etiketi yöntemi).
# Search Console > Mülk ekle > HTML etiketi adımından alınır.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Tıklama özetlerinde kullanılan gizli anahtar. Üretimde MUTLAKA değiştirin:
# öngörülebilir bir değer, IP özetlerinin kaba kuvvetle çözülmesini sağlar.
CLICK_HASH_SECRET=degistirin-uzun-rastgele-bir-deger

# --- Uzak görsel alan adları -------------------------------------------------
# Next.js görsel optimize edicisinin (/_next/image) indirmesine İZİN VERİLEN
# alan adları. Virgülle ayrılır: cdn.magaza.com,img.baska.net
#
# BOŞ BIRAKIN. Boşken uzak görsel optimizasyonu kapalıdır ve bu güvenli
# varsayılandır: uygulama `next/image` kullanmıyor, bütün görseller düz
# <img> ile doğrudan tarayıcıdan yükleniyor. Liste doldurulmadıkça
# /_next/image bir SSRF/kaynak tüketimi yüzeyi olmaktan çıkar.
#
# İlk gerçek mağaza bağlandığında YALNIZCA o mağazanın CDN alan adını yazın.
# Joker (* veya **) kabul edilmez; derleme düşer.
OHAAAA_IMAGE_HOSTS=

# --- Görselle arama ---------------------------------------------------------
# Fotoğraftan ürün tanıma için görme modeli anahtarı.
#
# BOŞ BIRAKILABİLİR. Anahtar yoksa fotoğraf yükleme uç noktası isteği hiç
# okumadan reddeder ve kullanıcıya "görselle arama şu an kapalı" der.
# BARKOD okuma ve SESLİ arama bu anahtardan bağımsızdır; her durumda çalışır.
#
# Yalnızca sunucuda kullanılır — NEXT_PUBLIC_ ön eki ASLA verilmemelidir.
ANTHROPIC_API_KEY=

# Kullanılacak model. Boşsa claude-haiku-4-5-20251001 (hızlı ve ucuz; ürün
# adlandırma için yeterli).
VISUAL_SEARCH_MODEL=

# --- Ödeme -------------------------------------------------------------------
# Ödeme sağlayıcısının adı (iyzico, paytr…). BOŞSA gerçek veritabanına bağlı
# çalışırken /api/checkout siparişi 503 ile REDDEDER.
#
# Sebebi: tahsilat henüz bir simülasyon. Kapıyı açık bırakmak, ilk gerçek
# satıcının malını bedelsiz göndermesi demek olurdu — zararı sözleşme gereği
# iadeden de sorumlu olan satıcı çeker.
OHAAAA_PAYMENT_PROVIDER=

# Sağlayıcısız bir ortamda uçtan uca deneme yapmak için: 1 yazıldığında
# yukarıdaki koruma devre dışı kalır. ÜRETİMDE ASLA 1 YAPMAYIN.
OHAAAA_ALLOW_SIMULATED_PAYMENT=

# --- E-posta bildirimleri ----------------------------------------------------
# Sipariş onayı ve kargo bildirimi buradan gider.
#
# BOŞ BIRAKILABİLİR. Anahtar yoksa e-posta GÖNDERİLMEZ ve bu durum kayda
# "sağlayıcı yapılandırılmamış" olarak düşer — sessizce "gönderildi"
# denmez. Sipariş akışı bundan etkilenmez: bildirim gitmese de sipariş
# geçerlidir.
#
# Anahtar https://resend.com üzerinden alınır. MAIL_FROM, o hesapta
# DOĞRULANMIŞ bir alan adına ait olmalıdır; değilse sağlayıcı reddeder.
RESEND_API_KEY=
MAIL_FROM=Ohaaaa <siparis@ohaaaa.com>

# --- Zamanlanmış işler -------------------------------------------------------
# Fiyat düşüş bildirimlerini çalıştıran uç noktanın sırrı. Vercel Cron bu
# değeri `authorization: Bearer <deger>` olarak gönderir.
#
# TANIMLI DEĞİLSE uç nokta 503 ile KAPALIDIR. Boş bir sırla "herkese açık"
# duruma düşmek en kötü varsayılan olurdu: uç noktayı çalıştırmak e-posta
# göndertmek demek, yani siteyi kendi kullanıcılarına spam atan bir araca
# çevirir.
CRON_SECRET=

# --- Doğal dil arama ---------------------------------------------------------
# Cümleyi ("5 bin liraya kadar oyuncu kulaklığı bul") arama filtrelerine çeviren
# model. Görselle aramayla AYNI anahtarı kullanır (ANTHROPIC_API_KEY);
# anahtar yoksa doğal dil çözümü hiç denenmez ve kullanıcının yazdığı metin
# olduğu gibi aranır — arama bozulmaz.
#
# Varsayılan model en yetenekli olanıdır. Arama kutusunda gecikme kritikse
# daha hızlı bir modele geçebilirsiniz; bu bir maliyet/gecikme kararıdır ve
# işletmecinindir.
SEARCH_INTENT_MODEL=

# --- Yapay zekâ bütçe tavanları ---------------------------------------------
# İki AI uç noktası da (doğal dil araması ve görselle arama) KİMLİKSİZDİR:
# adres çubuğundan tetiklenirler. Tavan olmadan tek bir betik model
# bütçesini saatler içinde tüketebilir — bu bir veri sızıntısı değil,
# doğrudan finansal hizmet reddidir.
#
# İki katman var: kişi başı saatlik hak (tek kötü niyetliyi durdurur) ve
# küresel günlük tavan (dağıtık kullanımı ve talep patlamasını durdurur).
#
# Tavan aşıldığında ARAMA BOZULMAZ: doğal dil çözümü atlanır ve yazılan
# metin olduğu gibi aranır. Görselle aramada kullanıcıya ne olduğu söylenir.
#
# Aşağıdaki değerler makul VARSAYILANLARDIR ve keyfîdir. Gerçek değer,
# gerçek kullanım ve gerçek fatura görüldükten sonra belirlenir; bu bir
# maliyet kararıdır ve işletmecinindir. Boş bırakılırsa varsayılan geçerli.
AI_ARAMA_IP_SAATLIK=
AI_ARAMA_GUNLUK=
AI_GORSEL_IP_SAATLIK=
AI_GORSEL_GUNLUK=

# --- Kimlik doğrulama hız sınırı --------------------------------------------
# Giriş eylemi kullanıcı numaralandırmaya karşı zaten korumalı ("e-posta veya
# parola hatalı"), ama deneme SAYISI sınırsızdı: sözlük saldırısı için tek
# gereken zamandı.
#
# İki ayrı kova sayılır ve ikisi farklı saldırıyı durdurur:
#   IP kovası      — tek kaynaktan sözlük saldırısı
#   E-posta kovası — çok sayıda IP'den TEK hesaba saldırı (IP sınırı bunu görmez)
#
# E-posta ham saklanmaz; günlük tuzlanmış özeti kova anahtarı olur — sayaç
# tablosu, denenen adreslerin listesine dönüşmesin diye.
#
# Kayıt ayrıca daha dar: her deneme bir doğrulama e-postası tetikler ve
# sınırsız bırakılırsa site kendi alan adından spam gönderen bir araca döner.
GIRIS_IP_DENEME=
GIRIS_GUNLUK=
KAYIT_IP_SAATLIK=
KAYIT_GUNLUK=

# --- Ortaklık feed'i kimlik bilgileri ----------------------------------------
# Ortaklık ağlarının ürün feed adresleri jetonu genellikle adresin İÇİNDE
# taşır. O adresi olduğu gibi `sources.endpoint_url` sütununa yazmak, jetonu
# veritabanında DÜZ METİN tutmak demektir: yedeklerde, yönetim panelinde ve
# her `select *` çıktısında görünür.
#
# Bu yüzden sütunda jetonun kendisi değil ŞABLONU durur:
#
#   https://feed.ornek.com/export.csv?publisher=41823&token=${OHAAAA_FEED_TOKEN}
#
# `${DEGISKEN}` yer tutucusu yalnızca çalışma anında, buradan (ya da
# barındırma platformunun sır yöneticisinden) doldurulur ve doldurulduğu anda
# maskeleme defterine yazılır: bundan sonra hiçbir hata metninde, veritabanı
# sütununda ya da CI günlüğünde görünemez.
#
# Değişken TANIMSIZSA alım turu açık bir hatayla durur ve hata DEĞİŞKEN ADINI
# söyler, değerini değil. Yer tutucu içermeyen (kimlik gerektirmeyen) adresler
# değişmeden geçer.
#
# Aşağıdaki ad bir ÖRNEKTİR; şablonda hangi adı yazarsanız o okunur. Birden
# çok kaynak için birden çok değişken tanımlayabilirsiniz.
OHAAAA_FEED_TOKEN=
