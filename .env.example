# =============================================================================
# OHAAAA — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve doldurun. `.env` git'e ASLA girmez.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Proje ayarları > API bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role anahtarı RLS'i BYPASS EDER.
# Yalnızca sunucuda kullanılır; NEXT_PUBLIC_ ön eki ASLA verilmemelidir.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Taşeron API (packages/backend) -----------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Virgülle ayrılmış izinli origin listesi. Üretimde '*' KULLANMAYIN.
CORS_ORIGINS=http://localhost:3000

# Anahtar başına dakikalık istek tavanının mutlak üst sınırı.
RATE_LIMIT_CEILING=6000

# --- Web (apps/web) ----------------------------------------------------------
# Taşeron API'sinin adresi (panelde örnek kod bloklarında gösterilir).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
