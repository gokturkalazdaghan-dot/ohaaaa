# =============================================================================
# OHAAAA — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve doldurun. `.env` git'e ASLA girmez.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Proje ayarları > API bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role anahtarı RLS'i BYPASS EDER.
# Yalnızca sunucuda kullanılır; NEXT_PUBLIC_ ön eki ASLA verilmemelidir.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Taşeron API (packages/backend) -----------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Virgülle ayrılmış izinli origin listesi. Üretimde '*' KULLANMAYIN.
CORS_ORIGINS=http://localhost:3000

# Anahtar başına dakikalık istek tavanının mutlak üst sınırı.
RATE_LIMIT_CEILING=6000

# --- Web (apps/web) ----------------------------------------------------------
# Taşeron API'si artık SİTENİN KENDİSİNDE sunulur (/api/v1/*). Bu değişkeni
# ayarlamaya gerek yoktur; boş bırakılırsa dokümantasyon sitenin kendi
# adresini gösterir. Yalnızca API ayrı bir alan adına taşınırsa doldurun.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Yayın durumu ------------------------------------------------------------
# prelaunch : site erişilebilir ama arama motorlarına KAPALI (varsayılan)
# live      : tam yayın
#
# Ayarlanmazsa 'prelaunch' kabul edilir — güvenli tarafta hata yapar.
# 'live' yapmadan ÖNCE: işletme kaydı, ETBİS numarası ve yasal metinlerdeki
# köşeli parantezli alanların tamamlanmış olması gerekir.
NEXT_PUBLIC_LAUNCH_STATE=prelaunch

# --- SEO ve ölçümleme --------------------------------------------------------
# Google Analytics 4 ölçüm kimliği. BOŞSA betik hiç yüklenmez.
# Yüklense bile kullanıcı çerez onayı vermeden çalışmaz (KVKK).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console doğrulama kodu (meta etiketi yöntemi).
# Search Console > Mülk ekle > HTML etiketi adımından alınır.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Tıklama özetlerinde kullanılan gizli anahtar. Üretimde MUTLAKA değiştirin:
# öngörülebilir bir değer, IP özetlerinin kaba kuvvetle çözülmesini sağlar.
CLICK_HASH_SECRET=degistirin-uzun-rastgele-bir-deger

# --- Görselle arama ---------------------------------------------------------
# Fotoğraftan ürün tanıma için görme modeli anahtarı.
#
# BOŞ BIRAKILABİLİR. Anahtar yoksa fotoğraf yükleme uç noktası isteği hiç
# okumadan reddeder ve kullanıcıya "görselle arama şu an kapalı" der.
# BARKOD okuma ve SESLİ arama bu anahtardan bağımsızdır; her durumda çalışır.
#
# Yalnızca sunucuda kullanılır — NEXT_PUBLIC_ ön eki ASLA verilmemelidir.
ANTHROPIC_API_KEY=

# Kullanılacak model. Boşsa claude-haiku-4-5-20251001 (hızlı ve ucuz; ürün
# adlandırma için yeterli).
VISUAL_SEARCH_MODEL=

# --- Ödeme -------------------------------------------------------------------
# Ödeme sağlayıcısının adı (iyzico, paytr…). BOŞSA gerçek veritabanına bağlı
# çalışırken /api/checkout siparişi 503 ile REDDEDER.
#
# Sebebi: tahsilat henüz bir simülasyon. Kapıyı açık bırakmak, ilk gerçek
# satıcının malını bedelsiz göndermesi demek olurdu — zararı sözleşme gereği
# iadeden de sorumlu olan satıcı çeker.
OHAAAA_PAYMENT_PROVIDER=

# Sağlayıcısız bir ortamda uçtan uca deneme yapmak için: 1 yazıldığında
# yukarıdaki koruma devre dışı kalır. ÜRETİMDE ASLA 1 YAPMAYIN.
OHAAAA_ALLOW_SIMULATED_PAYMENT=

# --- E-posta bildirimleri ----------------------------------------------------
# Sipariş onayı ve kargo bildirimi buradan gider.
#
# BOŞ BIRAKILABİLİR. Anahtar yoksa e-posta GÖNDERİLMEZ ve bu durum kayda
# "sağlayıcı yapılandırılmamış" olarak düşer — sessizce "gönderildi"
# denmez. Sipariş akışı bundan etkilenmez: bildirim gitmese de sipariş
# geçerlidir.
#
# Anahtar https://resend.com üzerinden alınır. MAIL_FROM, o hesapta
# DOĞRULANMIŞ bir alan adına ait olmalıdır; değilse sağlayıcı reddeder.
RESEND_API_KEY=
MAIL_FROM=Ohaaaa <siparis@ohaaaa.com>
