{
  "name": "@ohaaaa/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Web, mobil ve backend arasında paylaşılan tipler, şemalar ve iş kuralları",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
