{
  "name": "@ohaaaa/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Web, mobil ve backend arasında paylaşılan tipler, şemalar ve iş kuralları",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./api-key": {
      "types": "./dist/apiKey.d.ts",
      "default": "./dist/apiKey.js"
    },
    "./affiliate": {
      "types": "./dist/affiliate.d.ts",
      "default": "./dist/affiliate.js"
    },
    "./product-sync": {
      "types": "./dist/productSync.d.ts",
      "default": "./dist/productSync.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.2",
    "@supabase/supabase-js": "^2.112.4"
  }
}
